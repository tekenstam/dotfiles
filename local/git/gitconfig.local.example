#    standup = !git log --since=yesterday --author=\"$(git config user.name)\" --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr)%Creset'
#    today = !git log --since=midnight --author=\"$(git config user.name)\" --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr)%Creset'
#    changelog = !git log --pretty=format:'%s' --reverse --no-merges
