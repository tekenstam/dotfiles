#!/bin/bash

# Script to create a backup of current dotfiles before making changes

DOTFILES_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/.."
BACKUP_DIR="$HOME/.dotfiles_backup/$(date +%Y%m%d%H%M%S)"

mkdir -p "$BACKUP_DIR"

echo "Creating backup of current dotfiles to $BACKUP_DIR"

# Backup ZSH files
if [ -f "$HOME/.zshrc" ]; then
  cp "$HOME/.zshrc" "$BACKUP_DIR/"
fi

if [ -f "$HOME/.zprofile" ]; then
  cp "$HOME/.zprofile" "$BACKUP_DIR/"
fi

if [ -f "$HOME/.zsh_aliases" ]; then
  cp "$HOME/.zsh_aliases" "$BACKUP_DIR/"
fi

# Backup Git files
if [ -f "$HOME/.gitconfig" ]; then
  cp "$HOME/.gitconfig" "$BACKUP_DIR/"
fi

if [ -f "$HOME/.gitignore_global" ]; then
  cp "$HOME/.gitignore_global" "$BACKUP_DIR/"
fi

# Backup Vim files
if [ -f "$HOME/.vimrc" ]; then
  cp "$HOME/.vimrc" "$BACKUP_DIR/"
fi

# Backup Starship config
if [ -f "$HOME/.config/starship.toml" ]; then
  mkdir -p "$BACKUP_DIR/.config"
  cp "$HOME/.config/starship.toml" "$BACKUP_DIR/.config/"
fi

# Backup local config (not tracked in repo)
if [ -f "$HOME/.gitconfig.local" ]; then
  cp "$HOME/.gitconfig.local" "$BACKUP_DIR/"
fi
if [ -f "$HOME/.zshrc.local" ]; then
  cp "$HOME/.zshrc.local" "$BACKUP_DIR/"
fi
if [ -f "$HOME/.vimrc.local" ]; then
  cp "$HOME/.vimrc.local" "$BACKUP_DIR/"
fi

echo "Backup completed successfully!"
