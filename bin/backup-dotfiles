#!/bin/bash

# Script to create a backup of current dotfiles before making changes

DOTFILES_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/.."
BACKUP_DIR="${HOME:?HOME must be set}/.dotfiles_backup/$(date +%Y%m%d%H%M%S)"

mkdir -p "$BACKUP_DIR"

echo "Creating backup of current dotfiles to $BACKUP_DIR"

# Use -L so symlinks are dereferenced and we store actual file content
CP_OPTS="-L"
COUNT=0

# Backup ZSH files
if [ -e "$HOME/.zshrc" ]; then
  cp $CP_OPTS "$HOME/.zshrc" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

if [ -e "$HOME/.zprofile" ]; then
  cp $CP_OPTS "$HOME/.zprofile" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

if [ -e "$HOME/.zsh_aliases" ]; then
  cp $CP_OPTS "$HOME/.zsh_aliases" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

# Backup Git files
if [ -e "$HOME/.gitconfig" ]; then
  cp $CP_OPTS "$HOME/.gitconfig" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

if [ -e "$HOME/.gitignore_global" ]; then
  cp $CP_OPTS "$HOME/.gitignore_global" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

# Backup Vim files
if [ -e "$HOME/.vimrc" ]; then
  cp $CP_OPTS "$HOME/.vimrc" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

# Backup Starship config
if [ -e "$HOME/.config/starship.toml" ]; then
  mkdir -p "$BACKUP_DIR/.config"
  cp $CP_OPTS "$HOME/.config/starship.toml" "$BACKUP_DIR/.config/" && COUNT=$((COUNT + 1))
fi

# Backup local config (not tracked in repo)
if [ -e "$HOME/.gitconfig.local" ]; then
  cp $CP_OPTS "$HOME/.gitconfig.local" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi
if [ -e "$HOME/.zshrc.local" ]; then
  cp $CP_OPTS "$HOME/.zshrc.local" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi
if [ -e "$HOME/.vimrc.local" ]; then
  cp $CP_OPTS "$HOME/.vimrc.local" "$BACKUP_DIR/" && COUNT=$((COUNT + 1))
fi

if [ "$COUNT" -eq 0 ]; then
  echo "Warning: no dotfiles were found to back up. Is HOME correct ($HOME)? Did you run install first?" >&2
else
  echo "Backup completed successfully! ($COUNT file(s) copied.)"
fi
