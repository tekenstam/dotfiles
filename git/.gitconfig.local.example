# Copy this file to ~/.gitconfig.local and customize with your personal information
# This file is not tracked by Git to keep your personal details private

[user]
	name = Your Name
	email = your.email@example.com

# Optional: Add signing key for commits
# [user]
#   signingkey = YOUR_GPG_KEY_ID

# Optional: Enable commit signing
# [commit]
#   gpgsign = true

# Optional: Configure GitHub-specific settings
# [github]
#   user = your-github-username
